<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</head>

<body>
    <div class="container">
        <h3>View detail a user</h3>
        <form action="/handle-update-user" method="post">
            <input type="text" style="display: none;" value="<%= user.id %>" name="id">
            <div class="mb-3">
                <label class="form-label">Name:</label>
                <input type="text" value="<%= user.name %>" name="fullName" class="form-control" placeholder="Your name">
            </div>
            <div class="mb-3">
                <label class="form-label">Email:</label>
                <input type="email" value="<%= user.email %>" name="email" class="form-control" placeholder="name@example.com">
            </div>
            <div class="mb-3">
                <label class="form-label">Address:</label>
                <textarea type="text" name="address" class="form-control"><%= user.address %></textarea>
            </div>
            <button type="submit" class="btn btn-primary" >Update</button>
        </form>
    </div>
    <style>
        body {
            padding: 20px;
        }

        .container {
            width: 80%;
            margin: auto;
        }
    </style>
</body>

</html>